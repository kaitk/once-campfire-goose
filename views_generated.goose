fn render_message_html(out: u8[>..]&, ctx: const ViewContext&, message: const MessageView&) {
    if message.unrenderable {
    out.append("\n  ");
    out.append("<div class=\"message message--formatted message--failed center\">\n  <div class=\"message__body\">\n    <div class=\"message__body-content txt-align-center\">\n      Failed to load message content\n    </div>\n  </div>\n</div>");
    } else {
    out.append("\n  <div id=\"");
    html_value(out, prefixed_id(message.dom_id, ""));
    out.append("\" class=\"message ");
    if message.all_emoji {
    out.append("message--emoji");
    }
    out.append("\" data-controller=\"reply\" data-user-id=\"");
    html_value(out, message.creator.id);
    out.append("\" data-message-id=\"");
    html_value(out, message.id);
    out.append("\" data-message-timestamp=\"");
    html_value(out, message.created_ms);
    out.append("\" data-message-updated-at=\"");
    html_value(out, message.updated_ms);
    out.append("\" data-sort-value=\"");
    html_value(out, message.created_ms);
    out.append("\" data-messages-target=\"message\" data-search-results-target=\"message\" data-refresh-room-target=\"message\" data-reply-composer-outlet=\"#composer\">\n    <h2 class=\"message__day-separator\"><time datetime=\"");
    html_value(out, message.created_iso);
    out.append("\" data-local-time-target=\"date\"></time></h2>\n\n    <figure class=\"avatar message__avatar\">\n      <a title=\"");
    html_value(out, message.creator.title);
    out.append("\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"");
    html_value(out, message.creator.path);
    out.append("\"><img aria-hidden=\"true\" src=\"");
    html_value(out, message.creator.avatar_url);
    out.append("\" width=\"48\" height=\"48\" /></a>\n    </figure>\n\n    <turbo-frame id=\"");
    html_value(out, prefixed_id(message.dom_id, "edit"));
    out.append("\">\n      <div class=\"message__body\">\n        <div class=\"message__body-content\">\n          <div class=\"message__meta\">\n            <h3 class=\"message__heading\">\n              <span class=\"message__author\" title=\"");
    html_value(out, message.creator.title);
    out.append("\">\n                <strong data-reply-target=\"author\">");
    html_value(out, message.creator.name);
    out.append("</strong>\n              </span>\n              <a target=\"_top\" class=\"message__permalink\" href=\"");
    html_value(out, message.at_path);
    out.append("\"><time class=\"message__timestamp\" datetime=\"");
    html_value(out, message.created_iso);
    out.append("\" data-local-time-target=\"time\"></time></a>\n              <span class=\"message__room\">\n                <a target=\"_top\" data-reply-target=\"link\" href=\"");
    html_value(out, message.at_path);
    out.append("\">");
    html_value(out, message.room_name);
    out.append("</a>\n              </span>\n            </h3>\n            ");
    out.append("<div class=\"message__actions\" data-controller=\"soft-keyboard\">\n  <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\">\n    <summary class=\"btn message__action-btn message__options-btn\">\n      <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("menu-dots-horizontal.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Message options</span>\n    </summary>\n\n    <div class=\"message__actions-menu border shadow\" data-popup-target=\"menu\">\n      <div class=\"quick-boosts\">");
    for reaction in reactions() {
    out.append("\n          <form data-turbo-frame=\"");
    html_value(out, prefixed_id(message.dom_id, "boosting"));
    out.append("\" data-action=\"popup#close\" action=\"");
    html_value(out, message.boosts_path);
    out.append("\" accept-charset=\"UTF-8\" method=\"post\">\n            <input type=\"hidden\" name=\"boost[content]\" id=\"boost_content\" value=\"");
    html_value(out, reaction.character);
    out.append("\" />\n            <button name=\"button\" type=\"submit\" title=\"");
    html_value(out, reaction.title);
    out.append("\" class=\"btn message__action-btn\" data-emoji=\"");
    html_value(out, reaction.character);
    out.append("\">\n              <figure class=\"margin-none boost-character\">");
    html_value(out, reaction.character);
    out.append("</figure>\n              <span class=\"for-screen-reader\">");
    html_value(out, reaction.title);
    out.append("</span>\n</button></form>");
    }
    out.append("\n\n        <a class=\"btn message__action-btn message__boost-btn\" data-turbo-frame=\"");
    html_value(out, prefixed_id(message.dom_id, "new_boost"));
    out.append("\" data-action=\"soft-keyboard#open popup#close\" href=\"");
    html_value(out, message.new_boost_path);
    out.append("\">\n          <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("boost.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n          <span class=\"for-screen-reader\">New boost</span>\n</a>      </div>\n\n      <div class=\"flex flex-wrap border-top margin-block-start-half pad-block-start-half message__actions-grid\">");
    if message.has_attachment {
    out.append("\n          <a class=\"btn message__action-btn center full-width hide-in-ios-pwa\" title=\"Download\" aria-label=\"Download\" href=\"");
    html_value(out, message.attachment.download_path);
    out.append("\">\n            <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("download.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n</a>\n          <button class=\"btn message__action-btn center full-width\" data-controller=\"web-share\" data-action=\"web-share#share\" data-web-share-files-value=\"");
    html_value(out, message.attachment.blob_path);
    out.append("\" data-web-share-title-value=\"");
    html_value(out, message.attachment.filename);
    out.append("\" title=\"Share\" aria-label=\"Share\">\n            <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("share.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n</button>");
    } else {
    out.append("\n          <button class=\"btn message__action-btn center full-width\" data-action=\"reply#reply\" title=\"Reply\" aria-label=\"Reply\">\n            <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("reply.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n</button>");
    }
    out.append("\n\n        <button class=\"btn message__action-btn center full-width\" title=\"Copy link\" aria-label=\"Copy link\" data-controller=\"copy-to-clipboard\" data-action=\"copy-to-clipboard#copy\" data-copy-to-clipboard-success-class=\"btn--success\" data-copy-to-clipboard-url-value=\"");
    html_value(out, message.at_path);
    out.append("\">\n          <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("link.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n</button>\n        <a class=\"btn message__action-btn center full-width message__edit-btn\" data-turbo-frame=\"");
    html_value(out, prefixed_id(message.dom_id, "edit"));
    out.append("\" title=\"Edit\" aria-label=\"Edit\" href=\"");
    html_value(out, message.edit_path);
    out.append("\">\n          <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("pencil.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n</a>      </div>\n    </div>\n</details></div>");
    out.append("\n          </div>\n          ");
    out.append("<div id=\"");
    html_value(out, prefixed_id(message.dom_id, "presentation"));
    out.append("\" dir=\"auto\" data-reply-target=\"body\" data-messages-target=\"body\">\n  ");
    out.append(message.presentation);
    out.append("\n</div>");
    out.append("\n          ");
    out.append("<turbo-frame id=\"");
    html_value(out, prefixed_id(message.dom_id, "boosting"));
    out.append("\">\n  <div class=\"boosts flex flex-wrap align-center gap full-width\" style=\"--column-gap: 0.4ch; --row-gap: 0\"\n      data-controller=\"turbo-streaming\" data-action=\"turbo:submit-start->turbo-streaming#unsubscribe\">\n    <div class=\"flex-inline flex-wrap gap\" id=\"");
    html_value(out, prefixed_id(message.dom_id, "boosts"));
    out.append("\" data-turbo-streaming-target=\"container\">");
    for boost in message.boosts {
    out.append("\n      ");
    render_boost_html(out, ctx, boost);
    }
    out.append("\n    </div>\n\n    <turbo-frame id=\"");
    html_value(out, prefixed_id(message.dom_id, "new_boost"));
    out.append("\">\n      <div class=\"flex-inline message__boost-inline\" data-controller=\"soft-keyboard\">\n        <a class=\"boost__action txt-small btn\" action=\"soft-keyboard#open\" href=\"");
    html_value(out, message.new_boost_path);
    out.append("\">\n          <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("boost.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n          <span class=\"for-screen-reader\">Add a boost</span>\n</a>      </div>\n</turbo-frame>  </div>\n</turbo-frame>");
    out.append("\n        </div>\n      </div>\n    </turbo-frame>\n</div>");
    }
}

fn render_boost_html(out: u8[>..]&, ctx: const ViewContext&, boost: const BoostView&) {
    out.append("<div id=\"");
    html_value(out, boost.dom_id);
    out.append("\"\n      class=\"boost boost-item flex-inline postion--relative max-width align-center fill-white gap\"\n      data-controller=\"boost-delete\" data-boost-delete-perform-class=\"boost--deleting\" data-boost-delete-reveal-class=\"expanded\" data-boost-delete-booster-id-value=\"");
    html_value(out, boost.booster.id);
    out.append("\">\n    <figure class=\"avatar boost__avatar flex-item-no-shrink\">\n      <a title=\"");
    html_value(out, boost.booster.title);
    out.append("\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"");
    html_value(out, boost.booster.path);
    out.append("\"><img aria-label=\"");
    html_value(out, boost.booster.name);
    out.append(" boosted ");
    html_value(out, boost.content);
    out.append("\" src=\"");
    html_value(out, boost.booster.avatar_url);
    out.append("\" width=\"48\" height=\"48\" /></a>\n    </figure>\n\n    <span role=\"button\" class=\"");
    if boost.all_emoji {
    out.append("txt-small txt-medium");
    } else {
    out.append("txt-small");
    }
    out.append("\" data-action=\"click-&gt;boost-delete#reveal keydown.enter-&gt;boost-delete#reveal:prevent\" data-boost-delete-target=\"content\">");
    html_value(out, boost.content);
    out.append("</span>\n\n    <form class=\"button_to\" method=\"post\" action=\"");
    html_value(out, boost.path);
    out.append("\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button data-action=\"boost-delete#perform\" data-boost-delete-target=\"button\" class=\"btn btn--negative flex-item-justify-end boost__delete\" type=\"submit\">\n      <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("minus.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Delete this boost</span>\n</button></form>  </div>\n  <span id=\"delete_boost_accessible_label\" class=\"for-screen-reader\">Press enter to delete this boost</span>");
}

fn render_direct_room_html(out: u8[>..]&, ctx: const ViewContext&, membership: const DirectView&) {
    out.append("\n  ");
    {
    var view_block_1: u8[>..] = [];
    view_block_1.append("\n");
    if membership.members.len > 1 {
    view_block_1.append("      <div class=\"avatar__group\">\n");
    for view_index_2 in min(membership.members.len, 4) {
    view_block_1.append("          <span class=\"avatar\">\n            ");
    view_block_1.append(image_html(membership.members[view_index_2].avatar_url, [html_attr("size", 20), html_attr("aria-hidden", "true")]));
    view_block_1.append("\n          </span>\n");
    }
    view_block_1.append("      </div>\n");
    } else {
    view_block_1.append("      <span class=\"avatar\">\n        ");
    view_block_1.append(image_html(membership.members[0].avatar_url, [html_attr("size", 48), html_attr("aria-hidden", "true")]));
    view_block_1.append("\n      </span>\n");
    }
    view_block_1.append("\n    <span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\">\n      <span class=\"txt-nowrap overflow-ellipsis\">\n        <span class=\"for-screen-reader\">Ping with</span>\n");
    if membership.members.len > 1 {
    view_block_1.append("          ");
    html_value(view_block_1, membership.initials);
    view_block_1.append("\n");
    } else {
    view_block_1.append("          ");
    html_value(view_block_1, membership.members[0].first_name);
    view_block_1.append("\n");
    }
    view_block_1.append("      </span>\n    </span>\n");
    out.append(block_link_to_room(membership.room_id, [html_attr("class", membership.classes), html_attr("id", record_dom_id("rooms_direct", membership.room_id, "list")), html_attr("data-sorted-list-number", membership.updated_at_epoch)], view_block_1));
    }
}

fn render_room_html(out: u8[>..]&, ctx: const ViewContext&) {
    out.append("<!DOCTYPE html>\n<html>\n  <head>\n    ");
    out.append(title_html(ctx.title));
    out.append("\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n    <meta name=\"view-transition\" content=\"same-origin\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    ");
    out.append(csp_meta_html());
    out.append("\n    ");
    out.append(current_user_meta(ctx));
    out.append("\n    ");
    out.append(cable_meta());
    out.append("\n\n    ");
    out.append(builder_html("meta", [html_attr("name", "vapid-public-key"), html_attr_opt("content", ctx.vapid_public_key)]));
    out.append("\n    ");
    out.append(builder_html("meta", [html_attr("name", "turbo-prefetch"), html_attr("content", "true")]));
    out.append("\n\n    ");
    out.append(builder_html("link", [html_attr("rel", "manifest"), html_attr("href", "/webmanifest.json")]));
    out.append("\n    ");
    out.append(builder_html("link", [html_attr("rel", "icon"), html_attr("href", ctx.account.logo_url), html_attr("type", "image/png")]));
    out.append("\n    ");
    out.append(builder_html("link", [html_attr("rel", "apple-touch-icon"), html_attr("href", ctx.account.logo_url)]));
    out.append("\n\n    ");
    out.append(ctx.stylesheet_tags);
    out.append("\n    ");
    out.append(custom_styles_html(ctx));
    out.append("\n\n    ");
    out.append(ctx.importmap_tags);
    out.append("\n\n");
    out.append("\n  <meta name=\"turbo-cache-control\" content=\"no-preview\">\n  <meta name=\"current-room-id\" content=\"");
    html_value(out, ctx.room.id);
    out.append("\">");
    out.append("  </head>\n\n  <body class=\"");
    html_value(out, body_classes(ctx));
    out.append("\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n");
    if ctx.account.has_logo {
    out.append("\n  ");
    out.append(account_logo_html(ctx, ""));
    }
    out.append("\n\n  <span class=\"btn btn--reversed btn--faux room--current\">\n    <h1 class=\"room__contents txt-medium overflow-ellipsis\">");
    if ctx.room.direct {
    out.append("\n        <span class=\"for-screen-reader\">Ping with</span>");
    }
    out.append("\n\n      ");
    html_value(out, ctx.room.display_name);
    out.append("\n    </h1>\n</span>\n\n  <a class=\"btn\" style=\"view-transition-name: edit-room-");
    html_value(out, ctx.room.id);
    out.append("\" data-room-id=\"");
    html_value(out, ctx.room.id);
    out.append("\" href=\"");
    html_value(out, ctx.room.edit_path);
    out.append("\">\n    <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("menu-dots-horizontal.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n    <span class=\"for-screen-reader\">Settings for this ");
    html_value(out, ctx.room.noun);
    out.append("</span>\n</a>\n\n  ");
    out.append("<span>\n  <span class=\"button_to_change_notifying\"\n      data-controller=\"notifications\" data-notifications-subscriptions-url-value=\"");
    html_value(out, "/users/me/push_subscriptions");
    out.append("\" data-notifications-attention-class=\"btn--pulsing\">\n    <turbo-frame data-controller=\"turbo-frame\" data-action=\"notifications:ready@window-&gt;turbo-frame#load\" data-turbo-frame-url-param=\"");
    html_value(out, str("/rooms/", ctx.room.id, "/involvement"));
    out.append("\" id=\"");
    html_value(out, prefixed_id(ctx.room.dom_id, "involvement"));
    out.append("\">\n      <button class=\"btn\" data-action=\"click->notifications#attemptToSubscribe\" data-notifications-target=\"bell\">\n        <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("notification-bell-loading.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n        <img aria-hidden=\"true\" hidden=\"hidden\" src=\"");
    html_value(out, asset_path("notification-bell-alert.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Notification settings for this ");
    html_value(out, ctx.room.noun);
    out.append("</span>\n      </button>\n</turbo-frame>\n    <dialog data-notifications-target=\"notAllowedNotice\" class=\"dialog pad center center-block border-radius border shadow\" style=\"--inline-space: var(--block-space)\">\n      <div class=\"flex flex-column txt-align-center\">\n        <span class=\"btn btn--faux center txt-x-large\">\n          <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("notification-bell-alert.svg"));
    out.append("\" width=\"48\" height=\"48\" />\n          <span class=\"for-screen-reader\">Notifications alert</span>\n        </span>\n\n        <section>\n          <h1 class=\"txt-large margin-none\">Notifications aren’t allowed</h1>\n          <div class=\"txt-align-start margin-block-start\">\n            ");
    if !((ctx.platform.safari || ctx.platform.chrome) && ctx.platform.ios) {
    out.append("  <details class=\"notifications-help\" data-notifications-target=\"details\">\n    <summary class=\"btn\">\n      ");
    out.append(image_html("external/web.svg", [html_attr("aria-hidden", "true"), html_attr("size", 20)]));
    out.append("\n      <strong>Check your ");
    html_value(out, capitalized(ctx.platform.browser));
    out.append(" settings</strong>\n      ");
    out.append(image_html("disclosure.svg", [html_attr("aria-hidden", "true"), html_attr("size", 10), html_attr("class", "disclosure")]));
    out.append("\n    </summary>\n\n");
    if ctx.platform.firefox && ctx.platform.android {
    out.append("        <ol>\n          <li>Tap <em>");
    out.append(image_html("lock.svg", [html_attr("alt", "the View site information button"), html_attr("size", 20)]));
    out.append("</em> in the address bar.</li>\n          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>\n        </ol>\n");
    } else if ctx.platform.edge && ctx.platform.desktop {
    out.append("        <h2 class=\"txt-normal txt-medium margin-block-start\">Turn on notifications for this website.</h2>\n        <ol>\n          <li>Click <em>");
    out.append(image_html("lock.svg", [html_attr("alt", "the View site information button"), html_attr("size", 20)]));
    out.append("</em> left of the address bar.</li>\n          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>\n        </ol>\n        <h2 class=\"txt-normal txt-medium margin-block-start\">Turn on notifications for ");
    html_value(out, capitalized(ctx.platform.browser));
    out.append(".</h2>\n        <ol>\n");
    if ctx.platform.windows {
    out.append("            <li>Click <em>Start</em>, then <em>Settings</em>.</li>\n            <li>Go to <em>System &gt; Notification</em>.</li>\n            <li>Click <em>");
    out.append(image_html("external/switch.svg", [html_attr("alt", "the switch"), html_attr("size", 22)]));
    out.append("</em> <em>ON</em> for ");
    html_value(out, capitalized(ctx.platform.browser));
    out.append(".</li>\n");
    } else {
    out.append("            <li>Click <em aria-label=\"the Apple menu\"></em> in the top left.</li>\n            <li>Click <em>System Settings…</em>.</li>\n            <li>Click <em>Notifications</em>.</li>\n            <li>Click <em>");
    html_value(out, capitalized(ctx.platform.browser));
    out.append("</em>.</li>\n            <li>Click <em>");
    out.append(image_html("external/switch.svg", [html_attr("alt", "the switch"), html_attr("size", 22)]));
    out.append("</em> to <em>Allow notifications</em>.</li>\n");
    }
    out.append("        </ol>\n");
    } else if ctx.platform.firefox && ctx.platform.desktop {
    out.append("        <h2 class=\"txt-normal txt-medium margin-block-start\">Turn on notifications for this website.</h2>\n        <ol>\n          <li>Click <em>");
    html_value(out, capitalized(ctx.platform.browser));
    out.append("</em> in the top left.</li>\n          <li>Click <em>Settings…</em>.</li>\n          <li>Click <em>Privacy & Security</em> in the sidebar.</li>\n          <li>Scroll down to <em>Permissions</em>.</li>\n          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>\n          <li>Select <em>Allow</em> next to <em>");
    html_value(out, absolute_url(ctx, "/"));
    out.append("</em>.</li>\n        </ol>\n\n        <h2 class=\"txt-normal txt-medium margin-block-start\">Turn on notifications for ");
    html_value(out, capitalized(ctx.platform.browser));
    out.append(".</h2>\n        <ol>\n");
    if ctx.platform.windows {
    out.append("            <li>Click <em>Start</em>, then <em>Settings</em>.</li>\n            <li>Go to <em>System &gt; Notification</em>.</li>\n            <li>Click <em>");
    out.append(image_html("external/switch.svg", [html_attr("alt", "the toggle button"), html_attr("size", 22)]));
    out.append("</em> <em>ON</em> for ");
    html_value(out, capitalized(ctx.platform.browser));
    out.append(".</li>\n");
    } else {
    out.append("            <li>Click <em aria-label=\"the Apple menu\"></em> in the top left.</li>\n            <li>Click <em>System Settings…</em>.</li>\n            <li>Click <em>Notifications</em>.</li>\n            <li>Click <em>");
    html_value(out, capitalized(ctx.platform.browser));
    out.append("</em>.</li>\n            <li>Click <em>");
    out.append(image_html("external/switch.svg", [html_attr("alt", "the switch"), html_attr("size", 22)]));
    out.append("</em> to <em>Allow notifications</em>.</li>\n");
    }
    out.append("        </ol>\n");
    } else if ctx.platform.chrome && ctx.platform.desktop {
    out.append("        <h2 class=\"txt-normal txt-medium margin-block-start\">Turn on notifications for this website.</h2>\n        <ol>\n          <li>Click the <em>");
