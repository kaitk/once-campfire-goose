    out.append("\" id=\"message_body\" input=\"message_body_trix_input_message\" name=\"message[body]\">\n                    <lexxy-prompt trigger=\"@\" name=\"mention\" src=\"");
    html_value(out, mention_prompt_url(ctx.room.id));
    out.append("\" remote-filtering=\"true\" empty-results=\"No matches\"></lexxy-prompt>\n</lexxy-editor>                </div>\n\n                <label class=\"btn btn--borderless txt-small flex-item-no-shrink composer__attachment-btn input--file\">\n                  <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("attachment.svg"));
    out.append("\" width=\"22\" height=\"22\" />\n                  <input type=\"file\" data-action=\"composer#filePicked\" multiple />\n                  <span class=\"for-screen-reader\">Attach a file</span>\n                </label>\n\n                <button class=\"btn btn--borderless txt-small flex-item-no-shrink composer__rich-text-btn\" type=\"button\" data-action=\"composer#toggleToolbar\">\n                  <img class=\"colorize--black\" aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("text-options.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n                  <span class=\"for-screen-reader\">Rich text</span>\n                </button>\n\n                <button name=\"send\" type=\"submit\" data-action=\"composer#submit\" class=\"btn btn--reversed flex-item-no-shrink txt-small\">\n                  <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("arrow-up.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n                  <span class=\"for-screen-reader\">Send Message</span>\n</button>              </div>\n            </div>\n          </div>\n        </fieldset>\n\n        <div class=\"typing-indicator gap txt-small align-center flex-inline\" data-typing-notifications-target=\"indicator\">\n          <div class=\"typing-indicator__author spinner\" data-typing-notifications-target=\"author\"></div>\n        </div>\n\n        <input data-composer-target=\"clientid\" type=\"hidden\" name=\"message[client_message_id]\" id=\"message_client_message_id\" />\n</form>    </turbo-frame>\n  </div>");
    out.append("      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n");
    out.append(sidebar_frame_html("/users/me/sidebar", ""));
    out.append("    </aside>\n\n    ");
    out.append("<dialog class=\"lightbox\" aria-label=\"Image Viewer (Press escape to close)\" data-lightbox-target=\"dialog\" data-action=\"close->lightbox#reset\">\n  <img src=\"\" class=\"lightbox__image\" data-lightbox-target=\"zoomedImage\" />\n\n  <form method=\"dialog\" class=\"lightbox__btn\">\n    <button class=\"btn\">\n      ");
    out.append(image_html("remove.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n      <span class=\"for-screen-reader\">Close image viewer</span>\n    </button>\n  </form>\n\n  <a href=\"\" class=\"lightbox__btn--download btn hide-in-ios-pwa\" data-lightbox-target=\"download\">\n    ");
    out.append(image_html("download.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n    <span class=\"for-screen-reader\">Download file</span>\n  </a>\n\n  <button class=\"lightbox__btn--share btn\"\n      data-controller=\"web-share\"\n      data-action=\"web-share#share\"\n      data-web-share-files-value=\"\"\n      data-lightbox-target=\"share\">\n    ");
    out.append(image_html("share.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n    <span class=\"for-screen-reader\">Share file</span>\n  </button>\n</dialog>\n");
    out.append("\n\n");
    if ctx.session_marker.len > 0 {
    out.append("      <div hidden=\"hidden\" data-controller=\"push-subscription-sync\" data-push-subscription-sync-url-value=\"/users/me/push_subscriptions\" data-push-subscription-sync-session-value=\"");
    html_value(out, ctx.session_marker);
    out.append("\"></div>\n");
    }
    out.append("\n    <a href=\"https://once.com\" id=\"app-logo\" target=\"_blank\" aria-label=\"Once software from 37signals home page\">\n      ");
    out.append(image_html("campfire-icon.png", [html_attr("alt", "Campfire logo"), html_attr("width", 256), html_attr("height", 216)]));
    out.append("\n    </a>\n  </body>\n</html>\n");
}

fn render_sidebar_html(out: u8[>..]&, ctx: const ViewContext&) {
    out.append("<!DOCTYPE html>\n<html>\n  <head>\n    ");
    out.append(title_html(ctx.title));
    out.append("\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n    <meta name=\"view-transition\" content=\"same-origin\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    ");
    out.append(csp_meta_html());
    out.append("\n    ");
    out.append(current_user_meta(ctx));
    out.append("\n    ");
    out.append(cable_meta());
    out.append("\n\n    ");
    out.append(builder_html("meta", [html_attr("name", "vapid-public-key"), html_attr_opt("content", ctx.vapid_public_key)]));
    out.append("\n    ");
    out.append(builder_html("meta", [html_attr("name", "turbo-prefetch"), html_attr("content", "true")]));
    out.append("\n\n    ");
    out.append(builder_html("link", [html_attr("rel", "manifest"), html_attr("href", "/webmanifest.json")]));
    out.append("\n    ");
    out.append(builder_html("link", [html_attr("rel", "icon"), html_attr("href", ctx.account.logo_url), html_attr("type", "image/png")]));
    out.append("\n    ");
    out.append(builder_html("link", [html_attr("rel", "apple-touch-icon"), html_attr("href", ctx.account.logo_url)]));
    out.append("\n\n    ");
    out.append(ctx.stylesheet_tags);
    out.append("\n    ");
    out.append(custom_styles_html(ctx));
    out.append("\n\n    ");
    out.append(ctx.importmap_tags);
    out.append("\n\n");
    out.append("  </head>\n\n  <body class=\"");
    html_value(out, body_classes(ctx));
    out.append("\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n");
    out.append("    </nav>\n\n");
    if ctx.notice.len > 0 {
    out.append("      <div class=\"flash\" data-controller=\"element-removal\" data-action=\"animationend->element-removal#remove\">\n        <div class=\"flash__inner shadow\" style=\"");
    if ctx.has_alert {
    out.append("--flash-background: var(--color-negative)");
    }
    out.append("\">\n");
    if ctx.has_alert {
    out.append("            ");
    out.append(image_html("alert.svg", [html_attr("aria-hidden", true), html_attr("size", 24), html_attr("class", "colorize--white")]));
    out.append("\n");
    } else {
    out.append("            ");
    out.append(image_html("check.svg", [html_attr("aria-hidden", true), html_attr("size", 24), html_attr("class", "colorize--white")]));
    out.append("\n");
    }
    out.append("        </div>\n        <span class=\"for-screen-reader\" role=\"alert\" aria-atomic=\"true\">");
    html_value(out, ctx.notice);
    out.append("</span>\n      </div>\n");
    }
    out.append("\n    <main id=\"main-content\">\n");
    {
    var view_block_1: u8[>..] = [];
    view_block_1.append("\n  ");
    view_block_1.append(stream_html(ctx.rooms_stream));
    view_block_1.append("\n  ");
    view_block_1.append(stream_html(ctx.user_rooms_stream));
    view_block_1.append("\n\n  <div class=\"sidebar__container overflow-y overflow-hide-scrollbar\"\n      data-controller=\"badge-dot\"\n      data-badge-dot-unread-class=\"unread\"\n      data-action=\"rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize\">\n    <turbo-frame id=\"direct_rooms_control\" target=\"_top\">\n      <div class=\"directs gap overflow-x overflow-hide-scrollbar\">\n        ");
    {
    var view_block_2: u8[>..] = [];
    view_block_2.append("\n          <span class=\"avatar avatar--icon\">\n            ");
    view_block_2.append(image_html("messages-add.svg", [html_attr("size", 20), html_attr("aria-hidden", "true"), html_attr("class", "colorize--black")]));
    view_block_2.append("\n          </span>\n\n          <span class=\"direct__author flex max-width min-width border-radius pad-inline-half\">\n            <span class=\"for-screen-reader\">New</span>\n            <span class=\"txt-small overflow-clip\">Ping</span>\n          </span>\n");
    view_block_1.append(block_link_to("/rooms/directs/new", [html_attr("class", "direct direct__new"), html_attr("data-turbo-frame", "_self")], view_block_2));
    }
    view_block_1.append("\n        <div id=\"direct_rooms\" contents data-controller=\"sorted-list\" data-action=\"rooms-list:unread@window->sorted-list#updateItem\">\n          ");
    for membership in ctx.direct_memberships {
    render_direct_room_html(view_block_1, ctx, membership);
    }
    view_block_1.append("        </div>\n\n        <div contents>\n          ");
    for user in ctx.placeholders {
    {
    var view_block_5: u8[>..] = [];
    view_block_5.append("\n  <span class=\"avatar\">\n    ");
    view_block_5.append(image_html(user.avatar_url, [html_attr("aria-hidden", "true")]));
    view_block_5.append("\n  </span>\n\n  <span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\">\n    <span class=\"txt-nowrap overflow-ellipsis\">\n      <span class=\"for-screen-reader\">Start a ping with</span>\n      ");
    html_value(view_block_5, user.first_name);
    view_block_5.append("\n    </span>\n  </span>\n");
    view_block_1.append(block_button_to(direct_user_url(user.id), [html_attr("class", "direct borderless fill-transparent unpad")], view_block_5));
    }
    }
    view_block_1.append("        </div>\n      </div>\n    </turbo-frame>\n\n    <div class=\"rooms position-relative flex flex-column gap\">\n      <div id=\"shared_rooms\" contents data-controller=\"sorted-list\">\n");
    for room in ctx.other_memberships {
    view_block_1.append("          ");
    {
    var view_block_7: u8[>..] = [];
    view_block_7.append("\n  <span class=\"overflow-ellipsis\">");
    html_value(view_block_7, room.name);
    view_block_7.append("</span>\n");
    view_block_1.append(block_link_to_room(room.id, [html_attr("id", record_dom_id(room.param_key, room.id, "list")), html_attr("data-sorted-list-name", room.name), html_attr("style", "--column-gap: 0.5em"), html_attr("class", room.classes)], view_block_7));
    }
    }
    view_block_1.append("      </div>\n\n");
    if ctx.can_create_rooms {
    view_block_1.append("        ");
    {
    var view_block_8: u8[>..] = [];
    view_block_8.append("\n          ");
    view_block_8.append(image_html("add.svg", [html_attr("size", 20), html_attr("aria-hidden", "true"), html_attr("style", "view-transition-name: new-room")]));
    view_block_8.append("\n");
    view_block_1.append(block_link_to("/rooms/opens/new", [html_attr("class", "rooms__new-btn btn room align-center gap txt-reversed"), html_attr("aria-label", "New Chat Room")], view_block_8));
    }
    }
    view_block_1.append("    </div>\n\n    <button class=\"btn sidebar__toggle\" data-action=\"toggle-class#toggle\">\n      ");
    view_block_1.append(image_html("menu.svg", [html_attr("size", 20), html_attr("aria-hidden", "true")]));
    view_block_1.append("\n      <span class=\"for-screen-reader\">Open menu</span>\n    </button>\n  </div>\n\n  <div class=\"flex align-end sidebar__tools gap justify-end\">\n    ");
    {
    var view_block_9: u8[>..] = [];
    view_block_9.append("\n      ");
    view_block_9.append(image_html(ctx.user.avatar_url, [html_attr("size", 48), html_attr("aria-hidden", "true"), html_attr("style", str("view-transition-name: avatar-", ctx.user.id))]));
    view_block_9.append("\n      <span class=\"for-screen-reader\">My Settings</span>\n");
    view_block_1.append(block_link_to("/users/me/profile", [html_attr("class", "btn avatar flex-item-no-shrink sidebar__tool")], view_block_9));
    }
    view_block_1.append("\n    ");
    {
    var view_block_10: u8[>..] = [];
    view_block_10.append("\n      ");
    view_block_10.append(image_html("settings.svg", [html_attr("size", 20), html_attr("aria-hidden", "true"), html_attr("style", "view-transition-name: account-settings")]));
    view_block_10.append("\n      <span class=\"for-screen-reader\">Account Settings</span>\n");
    view_block_1.append(block_link_to("/account/edit", [html_attr("class", "btn align-center gap txt-reversed sidebar__tool")], view_block_10));
    }
    view_block_1.append("  </div>\n");
    out.append(sidebar_frame_html("", view_block_1));
    }
    out.append("\n      <footer id=\"footer\">\n");
    out.append("      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n");
    out.append("    </aside>\n\n    ");
    out.append("<dialog class=\"lightbox\" aria-label=\"Image Viewer (Press escape to close)\" data-lightbox-target=\"dialog\" data-action=\"close->lightbox#reset\">\n  <img src=\"\" class=\"lightbox__image\" data-lightbox-target=\"zoomedImage\" />\n\n  <form method=\"dialog\" class=\"lightbox__btn\">\n    <button class=\"btn\">\n      ");
    out.append(image_html("remove.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n      <span class=\"for-screen-reader\">Close image viewer</span>\n    </button>\n  </form>\n\n  <a href=\"\" class=\"lightbox__btn--download btn hide-in-ios-pwa\" data-lightbox-target=\"download\">\n    ");
    out.append(image_html("download.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n    <span class=\"for-screen-reader\">Download file</span>\n  </a>\n\n  <button class=\"lightbox__btn--share btn\"\n      data-controller=\"web-share\"\n      data-action=\"web-share#share\"\n      data-web-share-files-value=\"\"\n      data-lightbox-target=\"share\">\n    ");
    out.append(image_html("share.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n    <span class=\"for-screen-reader\">Share file</span>\n  </button>\n</dialog>\n");
    out.append("\n\n");
    if ctx.session_marker.len > 0 {
    out.append("      <div hidden=\"hidden\" data-controller=\"push-subscription-sync\" data-push-subscription-sync-url-value=\"/users/me/push_subscriptions\" data-push-subscription-sync-session-value=\"");
    html_value(out, ctx.session_marker);
    out.append("\"></div>\n");
    }
    out.append("\n    <a href=\"https://once.com\" id=\"app-logo\" target=\"_blank\" aria-label=\"Once software from 37signals home page\">\n      ");
    out.append(image_html("campfire-icon.png", [html_attr("alt", "Campfire logo"), html_attr("width", 256), html_attr("height", 216)]));
    out.append("\n    </a>\n  </body>\n</html>\n");
}

fn render_search_html(out: u8[>..]&, ctx: const ViewContext&) {
    out.append("<!DOCTYPE html>\n<html>\n  <head>\n    ");
    out.append(title_html(ctx.title));
    out.append("\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n    <meta name=\"view-transition\" content=\"same-origin\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    ");
    out.append(csp_meta_html());
    out.append("\n    ");
    out.append(current_user_meta(ctx));
    out.append("\n    ");
    out.append(cable_meta());
    out.append("\n\n    ");
    out.append(builder_html("meta", [html_attr("name", "vapid-public-key"), html_attr_opt("content", ctx.vapid_public_key)]));
    out.append("\n    ");
    out.append(builder_html("meta", [html_attr("name", "turbo-prefetch"), html_attr("content", "true")]));
    out.append("\n\n    ");
    out.append(builder_html("link", [html_attr("rel", "manifest"), html_attr("href", "/webmanifest.json")]));
    out.append("\n    ");
    out.append(builder_html("link", [html_attr("rel", "icon"), html_attr("href", ctx.account.logo_url), html_attr("type", "image/png")]));
    out.append("\n    ");
    out.append(builder_html("link", [html_attr("rel", "apple-touch-icon"), html_attr("href", ctx.account.logo_url)]));
    out.append("\n\n    ");
    out.append(ctx.stylesheet_tags);
    out.append("\n    ");
    out.append(custom_styles_html(ctx));
    out.append("\n\n    ");
    out.append(ctx.importmap_tags);
    out.append("\n\n");
    out.append("  </head>\n\n  <body class=\"");
    html_value(out, body_classes(ctx));
    out.append("\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n");
    if ctx.has_query {
    out.append("\n    <div class=\"searches__query flex align-center gap pad-block-start-half\">\n      <div class=\"btn btn--reversed btn--faux align-center gap txt-nowrap\">\n        <span class=\"overflow-ellipsis\">“");
    html_value(out, ctx.query);
    out.append("”</span>\n        <span class=\"flex-item-no-shrink\">");
    html_value(out, ctx.messages.len);
    out.append("</span>\n</div>    </div>");
    }
    out.append("\n\n  <div class=\"searches__recents align-center gap pad-block-half overflow-y overflow-hide-scrollbar\">\n    ");
    for search in ctx.recent_searches {
    out.append("\n      <a class=\"align-center gap room btn txt-nowrap\" href=\"");
    html_value(out, search_url(search));
    out.append("\">\n        <span class=\"overflow-ellipsis\">“");
    html_value(out, search);
    out.append("”</span>\n</a>");
    }
    if !(ctx.recent_searches.len == 0) {
    out.append("\n      <form class=\"button_to\" method=\"post\" action=\"");
    html_value(out, absolute_url(ctx, "/searches/clear"));
    out.append("\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn searches__btn\" data-turbo-confirm=\"Are you sure you want to clear your recent searches?\" type=\"submit\">\n        <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("broom.svg"));
    out.append("\" />\n        <span class=\"for-screen-reader\">Clear recent searches</span>\n</button></form>");
    }
    out.append("\n  </div>");
    out.append("    </nav>\n\n");
    if ctx.notice.len > 0 {
    out.append("      <div class=\"flash\" data-controller=\"element-removal\" data-action=\"animationend->element-removal#remove\">\n        <div class=\"flash__inner shadow\" style=\"");
    if ctx.has_alert {
    out.append("--flash-background: var(--color-negative)");
    }
    out.append("\">\n");
    if ctx.has_alert {
    out.append("            ");
    out.append(image_html("alert.svg", [html_attr("aria-hidden", true), html_attr("size", 24), html_attr("class", "colorize--white")]));
    out.append("\n");
    } else {
    out.append("            ");
    out.append(image_html("check.svg", [html_attr("aria-hidden", true), html_attr("size", 24), html_attr("class", "colorize--white")]));
    out.append("\n");
    }
    out.append("        </div>\n        <span class=\"for-screen-reader\" role=\"alert\" aria-atomic=\"true\">");
    html_value(out, ctx.notice);
    out.append("</span>\n      </div>\n");
    }
    out.append("\n    <main id=\"main-content\">\n");
    out.append("\n<div id=\"message-area\" class=\"message-area\">\n  <div class=\"message-area--empty min-width center\">\n    <figure class=\"center pad\">\n      <img aria-hidden=\"true\" class=\"colorize--black translucent\" src=\"");
    html_value(out, asset_path("search.svg"));
    out.append("\" />\n    </figure>\n  </div>\n\n  <div id=\"search-results\" class=\"messages searches__results\" data-controller=\"search-results\" data-search-results-target=\"messages\" data-search-results-me-class=\"message--me\" data-search-results-threaded-class=\"message--threaded\" data-search-results-mentioned-class=\"message--mentioned\" data-search-results-formatted-class=\"message--formatted\">");
    for message in ctx.messages {
    out.append("\n    ");
    render_message_html(out, ctx, message);
    }
    out.append("\n  </div></div>");
    out.append("\n      <footer id=\"footer\">\n");
    out.append("\n  <div class=\"composer flex align-end gap\">\n    <a class=\"btn flex-item-no-shrink margin-block-end\" style=\"view-transition-name: input-switcher; --btn-border-radius: 0.5em\" href=\"");
    html_value(out, str("/rooms/", ctx.return_to_room_id));
    out.append("\">\n      <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("arrow-left.svg"));
    out.append("\" />\n      <span class=\"for-screen-reader\">Exit search </span>\n</a>\n    <form class=\"margin-block flex-item-grow contain flex align-center gap\" data-controller=\"form\" data-action=\"keydown.esc-&gt;form#cancel\" action=\"");
    html_value(out, "/searches");
    out.append("\" accept-charset=\"UTF-8\" method=\"post\">\n      <div class=\"composer__input flex align-center flex-item-grow gap full-width input input--actor min-width\">\n        <img aria-hidden=\"true\" class=\"composer__input-hint colorize--black\" style=\"view-transition-name: input-btn;\" src=\"");
    html_value(out, asset_path("search.svg"));
    out.append("\" width=\"20\" height=\"20\" />\n\n        <input");
    if ctx.has_q {
    out.append(" value=\"");
    html_value(out, ctx.q);
    out.append("\"");
    }
    out.append(" class=\"searches__input input flex-item-grow\" role=\"searchbox\" aria-label=\"search\" autofocus=\"autofocus\" required=\"required\" type=\"text\" name=\"q\" id=\"q\" />\n\n        <a data-form-target=\"cancel\" role=\"button\" class=\"searches__reset\" href=\"");
    html_value(out, "/searches");
    out.append("\">\n          <img aria-hidden=\"true\" class=\"colorize--black\" src=\"");
    html_value(out, asset_path("remove.svg"));
    out.append("\" width=\"14\" height=\"14\" />\n          <span class=\"for-screen-reader\">Clear search field</span>\n</a>\n        <button name=\"button\" type=\"submit\" class=\"btn btn--reversed flex-item-no-shrink txt-small\" style=\"--btn-border-radius: 0.5em\">\n          <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("arrow-up.svg"));
    out.append("\" />\n          <span class=\"for-screen-reader\">Search</span>\n</button>      </div>\n</form>  </div>");
    out.append("      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n");
    out.append("\n  <div class=\"rooms position-relative flex flex-column gap overflow-y overflow-hide-scrollbar\">\n    ");
    for search in ctx.recent_searches {
    out.append("\n      <a class=\"align-center gap room btn txt-nowrap\" href=\"");
    html_value(out, search_url(search));
    out.append("\">\n        <span class=\"overflow-ellipsis\">“");
    html_value(out, search);
    out.append("”</span>\n</a>");
    }
    if !(ctx.recent_searches.len == 0) {
    out.append("\n      <form class=\"button_to\" method=\"post\" action=\"");
    html_value(out, absolute_url(ctx, "/searches/clear"));
    out.append("\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn searches__btn\" data-turbo-confirm=\"Are you sure you want to clear your recent searches?\" type=\"submit\">\n        <img aria-hidden=\"true\" src=\"");
    html_value(out, asset_path("broom.svg"));
    out.append("\" />\n        <span class=\"for-screen-reader\">Clear recent searches</span>\n</button></form>");
    }
    out.append("\n  </div>");
    out.append("    </aside>\n\n    ");
    out.append("<dialog class=\"lightbox\" aria-label=\"Image Viewer (Press escape to close)\" data-lightbox-target=\"dialog\" data-action=\"close->lightbox#reset\">\n  <img src=\"\" class=\"lightbox__image\" data-lightbox-target=\"zoomedImage\" />\n\n  <form method=\"dialog\" class=\"lightbox__btn\">\n    <button class=\"btn\">\n      ");
    out.append(image_html("remove.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n      <span class=\"for-screen-reader\">Close image viewer</span>\n    </button>\n  </form>\n\n  <a href=\"\" class=\"lightbox__btn--download btn hide-in-ios-pwa\" data-lightbox-target=\"download\">\n    ");
    out.append(image_html("download.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n    <span class=\"for-screen-reader\">Download file</span>\n  </a>\n\n  <button class=\"lightbox__btn--share btn\"\n      data-controller=\"web-share\"\n      data-action=\"web-share#share\"\n      data-web-share-files-value=\"\"\n      data-lightbox-target=\"share\">\n    ");
    out.append(image_html("share.svg", [html_attr("aria-hidden", "true")]));
    out.append("\n    <span class=\"for-screen-reader\">Share file</span>\n  </button>\n</dialog>\n");
    out.append("\n\n");
    if ctx.session_marker.len > 0 {
    out.append("      <div hidden=\"hidden\" data-controller=\"push-subscription-sync\" data-push-subscription-sync-url-value=\"/users/me/push_subscriptions\" data-push-subscription-sync-session-value=\"");
    html_value(out, ctx.session_marker);
    out.append("\"></div>\n");
    }
    out.append("\n    <a href=\"https://once.com\" id=\"app-logo\" target=\"_blank\" aria-label=\"Once software from 37signals home page\">\n      ");
    out.append(image_html("campfire-icon.png", [html_attr("alt", "Campfire logo"), html_attr("width", 256), html_attr("height", 216)]));
    out.append("\n    </a>\n  </body>\n</html>\n");
}

fn render_messages_html(out: u8[>..]&, ctx: const ViewContext&) {
    for message in ctx.messages {
    out.append("\n");
    render_message_html(out, ctx, message);
    }
}

fn render_post_html(out: u8[>..]&, ctx: const ViewContext&, message: const MessageView&) {
    out.append("<turbo-stream action=\"append\" target=\"");
    html_value(out, room_dom_id(ctx.room.kind, message.room_id, "messages"));
    out.append("\"><template>");
    render_message_html(out, ctx, message);
    out.append("</template></turbo-stream>");
}

fn render_page_html(out: u8[>..]&, ctx: const ViewContext&) {
    out.append("<!DOCTYPE html>\n<html>\n  <head>\n    ");
    out.append(title_html(ctx.title));
    out.append("\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n    <meta name=\"view-transition\" content=\"same-origin\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    ");
    out.append(csp_meta_html());
    out.append("\n    ");
    out.append(current_user_meta(ctx));
    out.append("\n    ");
    out.append(cable_meta());
    out.append("\n\n    ");
    out.append(builder_html("meta", [html_attr("name", "vapid-public-key"), html_attr_opt("content", ctx.vapid_public_key)]));
    out.append("\n    ");
